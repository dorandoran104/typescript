extends ../include/head

block content
  .container
    .row
      .col-md-6
        img.img-fluid(src=detail.path)
      .col-md-6
        h1.product-title= detail.name
        p.product-price= detail.total_price + ' 원'
        p.product-description= detail.description
        button.btn.btn-primary.btn-lg(type="button") 구매하기

        //- 추가 정보 또는 리뷰 섹션
        h2 추가 정보
        ul.list-group
          li.list-group-item 제품 코드: #{detail.code}
          li.list-group-item 브랜드: #{detail.brand}
          li.list-group-item 재고 상태: #{detail.stock ? '재고 있음' : '품절'}

    //- 추천 상품 섹션
